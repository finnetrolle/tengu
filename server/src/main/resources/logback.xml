<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <immediateFlush>true</immediateFlush>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <lineSeparator>UNIX</lineSeparator>
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel/>
                <loggerName><fieldName>logger</fieldName></loggerName>
                <message/>
                <pattern>
                    <pattern>{"service_name":"tengu-server","service_version":"${tengu.service.version}"}</pattern>
                </pattern>
                <keyValuePairs>
                    <includeKeyName>event</includeKeyName>
                    <includeKeyName>request_id</includeKeyName>
                    <includeKeyName>user_id</includeKeyName>
                    <includeKeyName>http_method</includeKeyName>
                    <includeKeyName>http_route</includeKeyName>
                    <includeKeyName>http_status</includeKeyName>
                    <includeKeyName>duration_ms</includeKeyName>
                    <includeKeyName>outcome</includeKeyName>
                    <includeKeyName>tool</includeKeyName>
                    <includeKeyName>command</includeKeyName>
                    <includeKeyName>error_kind</includeKeyName>
                    <includeKeyName>exception_type</includeKeyName>
                    <includeKeyName>exception_stacktrace</includeKeyName>
                    <includeKeyName>response_body</includeKeyName>
                    <includeKeyName>response_body_bytes</includeKeyName>
                    <includeKeyName>response_body_truncated</includeKeyName>
                    <includeKeyName>config_key</includeKeyName>
                    <includeKeyName>allowed_values</includeKeyName>
                </keyValuePairs>
            </providers>
        </encoder>
    </appender>
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <maxFlushTime>1000</maxFlushTime>
        <appender-ref ref="STDOUT"/>
    </appender>
    <logger name="ru.finnetrolle.tengu" level="INFO"/>
    <root level="WARN"><appender-ref ref="ASYNC"/></root>
</configuration>
